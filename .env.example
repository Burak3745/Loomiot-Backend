# ---------- LOCAL GELİŞTİRME (npm run dev) ----------
PORT=3000
MONGO_URI=mongodb://localhost:27017/loomiot
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------- SUNUCU (docker-compose.prod.yml) ----------
# Şifrelerde sadece harf ve rakam kullan (MONGO_URI içinde özel karakter sorun çıkarır).
DOMAIN=ev.ornek.com
# Localde API_KEY satırını silersen/boş bırakırsan anahtar kontrolü kapalı olur.
API_KEY=buraya-uzun-rastgele-bir-anahtar
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=buraya-guclu-sifre
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=buraya-guclu-sifre
